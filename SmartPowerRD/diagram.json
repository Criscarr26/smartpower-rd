{
  "version": 1,
  "author": "Cristian Carrera 2024-1932 - ITLA",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },

    { "type": "wokwi-potentiometer", "id": "potV", "top": -180, "left": -290,
      "attrs": { "value": "620" } },
    { "type": "wokwi-potentiometer", "id": "potI", "top": -40, "left": -290,
      "attrs": { "value": "300" } },

    { "type": "wokwi-lcd1602", "id": "lcd", "top": -290, "left": 130,
      "attrs": { "pins": "i2c" } },

    { "type": "wokwi-led", "id": "ledRed", "top": 60, "left": 250,
      "attrs": { "color": "green", "label": "RED OK" } },
    { "type": "wokwi-led", "id": "ledInv", "top": 130, "left": 250,
      "attrs": { "color": "yellow", "label": "INVERSOR" } },
    { "type": "wokwi-led", "id": "ledAlm", "top": 200, "left": 250,
      "attrs": { "color": "red", "label": "ALARMA" } },

    { "type": "wokwi-resistor", "id": "r1", "top": 60, "left": 350,
      "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 130, "left": 350,
      "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": 200, "left": 350,
      "attrs": { "value": "220" } },

    { "type": "wokwi-buzzer", "id": "bz", "top": 280, "left": 250,
      "attrs": { "volume": "0.1" } },

    { "type": "wokwi-pushbutton", "id": "btn", "top": 280, "left": -290,
      "attrs": { "color": "blue", "label": "SILENCIO" } },

    { "type": "wokwi-relay-module", "id": "rele", "top": -290, "left": -430, "attrs": {} }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "" ],
    [ "esp:RX", "$serialMonitor:TX", "" ],

    [ "potV:VCC", "esp:3V3",   "red",   [] ],
    [ "potV:GND", "esp:GND.1", "black", [] ],
    [ "potV:SIG", "esp:34",    "green", [] ],

    [ "potI:VCC", "esp:3V3",   "red",   [] ],
    [ "potI:GND", "esp:GND.1", "black", [] ],
    [ "potI:SIG", "esp:35",    "green", [] ],

    [ "lcd:VCC", "esp:5V",    "red",   [] ],
    [ "lcd:GND", "esp:GND.2", "black", [] ],
    [ "lcd:SDA", "esp:21",    "blue",  [] ],
    [ "lcd:SCL", "esp:22",    "cyan",  [] ],

    [ "esp:25",    "ledRed:A",  "green", [] ],
    [ "ledRed:C",  "r1:1",      "black", [] ],
    [ "r1:2",      "esp:GND.3", "black", [] ],

    [ "esp:33",    "ledInv:A",  "yellow", [] ],
    [ "ledInv:C",  "r2:1",      "black",  [] ],
    [ "r2:2",      "esp:GND.3", "black",  [] ],

    [ "esp:32",    "ledAlm:A",  "red",   [] ],
    [ "ledAlm:C",  "r3:1",      "black", [] ],
    [ "r3:2",      "esp:GND.3", "black", [] ],

    [ "esp:27", "bz:1",      "purple", [] ],
    [ "bz:2",   "esp:GND.3", "black",  [] ],

    [ "esp:14",   "btn:1.l",   "orange", [] ],
    [ "btn:2.l",  "esp:GND.1", "black",  [] ],

    [ "rele:VCC", "esp:5V",    "red",     [] ],
    [ "rele:GND", "esp:GND.2", "black",   [] ],
    [ "rele:IN",  "esp:26",    "magenta", [] ]
  ],
  "dependencies": {}
}
